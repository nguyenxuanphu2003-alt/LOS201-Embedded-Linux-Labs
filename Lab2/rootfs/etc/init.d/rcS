#!/bin/sh

echo "[ LAB-02 ] Starting system initialization..."

# Mount virtual filesystems
mount -t proc none /proc
mount -t sysfs none /sys
mount -t tmpfs none /tmp

# Make sure /dev is available
mount -t devtmpfs none /dev 2>/dev/null || true

# Create essential device nodes if missing
[ -c /dev/console ] || mknod /dev/console c 5 1
[ -c /dev/null ] || mknod /dev/null c 1 3
[ -c /dev/zero ] || mknod /dev/zero c 1 5

hostname embedded-lab2

echo "[ LAB-02 ] Loading lab2_driver..."

if [ -f /lib/modules/5.15.0/lab2_driver.ko ]; then

    insmod /lib/modules/5.15.0/lab2_driver.ko

    if [ $? -eq 0 ]; then
        echo "[ LAB-02 ] lab2_driver loaded successfully"

        # Create character device if it does not already exist
        if [ ! -c /dev/lab2 ]; then
            mknod /dev/lab2 c 240 0
        fi

        chmod 666 /dev/lab2

        echo "[ LAB-02 ] /dev/lab2 created"

    else
        echo "[ LAB-02 ] ERROR: failed to load lab2_driver"
    fi

else
    echo "[ LAB-02 ] ERROR: lab2_driver.ko not found"
fi

echo "[ LAB-02 ] Initialization complete"
